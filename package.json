{
    "name": "@arrow-warfare/root",
    "version": "0.0.0",
    "description": "First person multiplayer archer game for phones, peer to peer over WebRTC, built on papit and WebGL2.",
    "private": true,
    "scripts": {
        "analyse": "npm run analyse --workspaces --if-present",
        "publish": "node bin/publish.mjs",
        "clean": "node bin/clean.mjs",
        "build": "npx @papit/build",
        "test": "node bin/test.mjs",
        "create": "npm create @papit -- --package",
        "start": "npx @papit/server --info --live",
        "version:reset": "npx @papit/version --reset",
        "version:sync": "npx @papit/version --sync",
        "signal": "npx @papit/signal-server --port 3001",
        "pages": "npm run pages --workspace=@arrow-warfare/game"
    },
    "keywords": [
        "typescript",
        "papit"
    ],
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": ">=20"
    },
    "author": "henry",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/onkelhoy/arrow-warfare.git"
    },
    "workspaces": [
        "game",
        "packages/**/*",
        "!packages/**/asset/**",
        "!packages/**/dist/**"
    ],
    "devDependencies": {
        "@papit/analyse": "*",
        "@papit/arguments": "*",
        "@papit/build": "*",
        "@papit/bundle-js": "*",
        "@papit/bundle-ts": "*",
        "@papit/create": "*",
        "@papit/information": "*",
        "@papit/react": "*",
        "@papit/server": "*",
        "@papit/signal-server": "^0.1.2",
        "@papit/static": "^0.0.8",
        "@papit/terminal": "*",
        "@papit/version": "*",
        "esbuild": "0.27.2",
        "typescript": "5.9.3"
    },
    "papit": {}
}
