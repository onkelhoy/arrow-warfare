{
  "name": "@arrow-warfare/qr-code",
  "description": "SVG QR code generated in the browser, from cowboy.",
  "keywords": [
    "papit",
    "typescript",
    "qr-code"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/arrow-warfare/tree/main/packages/atoms/qr-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/arrow-warfare.git",
    "directory": "packages/atoms/qr-code"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/web-component": "^0.0.14",
    "@papit/translator": "^0.1.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "papit": {
    "publish": false,
    "type": "web-component",
    "main": "qr-code",
    "htmlprefix": "aw",
    "components": {
      "qr-code": {
        "className": "QrCode",
        "htmlprefix": "aw"
      }
    }
  }
}
