{
  "name": "@arrow-warfare/core",
  "description": "Settings, colours, fullscreen and words shared by every part of the game.",
  "keywords": [
    "papit",
    "typescript",
    "core"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/arrow-warfare/tree/main/packages/foundations/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/arrow-warfare.git",
    "directory": "packages/foundations/core"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/signals": "^0.0.1",
    "@papit/translator": "^0.1.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@papit/codeblock": "*",
    "@papit/button": "*",
    "@papit/input": "*"
  },
  "papit": {
    "publish": false,
    "type": "browser",
    "main": "core"
  }
}
