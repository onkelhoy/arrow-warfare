{
  "name": "@arrow-warfare/sound",
  "description": "Web Audio for the game: sound effects, and the lobby and game playlists from songs.json.",
  "keywords": [
    "papit",
    "typescript",
    "sound"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/arrow-warfare/tree/main/packages/foundations/sound",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/arrow-warfare.git",
    "directory": "packages/foundations/sound"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "5.9.3",
    "@papit/theme": "*",
    "@papit/button": "*"
  },
  "papit": {
    "publish": false,
    "type": "browser",
    "main": "sound"
  }
}
