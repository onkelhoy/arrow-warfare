{
  "name": "@arrow-warfare/rig",
  "description": "The silly body: rigid parts on an armature rig, a procedural walk, hops, sitting, falling over, hit capsules from the bones.",
  "keywords": [
    "papit",
    "typescript",
    "rig"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/arrow-warfare/tree/main/packages/foundations/rig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/arrow-warfare.git",
    "directory": "packages/foundations/rig"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@arrow-warfare/archery": "*",
    "@arrow-warfare/ragdoll": "*",
    "@arrow-warfare/render": "*",
    "@arrow-warfare/world": "*",
    "@papit/armature": "^0.0.2"
  },
  "devDependencies": {
    "@papit/game-engine": "*",
    "@papit/theme": "*",
    "typescript": "5.9.3"
  },
  "papit": {
    "publish": false,
    "type": "browser",
    "main": "rig",
    "htmlprefix": "aw"
  }
}
