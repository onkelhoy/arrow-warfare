{
  "name": "@arrow-warfare/world",
  "description": "The meadow from a seed: ground, trees, grass, flowers, the forest edge, spawns, collisions and the time of day.",
  "keywords": [
    "papit",
    "game",
    "typescript",
    "world"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/arrow-warfare/tree/main/packages/foundations/world",
  "bugs": {
    "url": "https://github.com/onkelhoy/arrow-warfare/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/arrow-warfare.git",
    "directory": "packages/foundations/world"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/game-engine": "*",
    "@arrow-warfare/render": "*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@papit/theme": "*"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "papit": {
    "publish": false,
    "type": "game",
    "main": "world",
    "components": {}
  }
}
