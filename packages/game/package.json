{
  "name": "@arrow-warfare/game",
  "description": "Arrow Warfare, the app: brings the pages together and builds the site.",
  "keywords": [
    "papit",
    "game",
    "typescript"
  ],
  "version": "0.0.1",
  "scripts": {
    "prebuild": "node bin/sync-assets.mjs && node bin/icons.mjs",
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npm run build && npx @papit/server --info --live",
    "pages": "npm run build && npx @papit/static -- --base /arrow-warfare/ --output ../../docs --info"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/arrow-warfare/tree/main/packages/game",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/arrow-warfare.git",
    "directory": "packages/game"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/theme": "*",
    "@arrow-warfare/core": "*",
    "@arrow-warfare/net": "*",
    "@arrow-warfare/sound": "*",
    "@arrow-warfare/corner": "*",
    "@arrow-warfare/menu": "*",
    "@arrow-warfare/lobby": "*",
    "@arrow-warfare/play": "*",
    "@papit/signals": "^0.0.1",
    "@papit/translator": "^0.1.1",
    "@arrow-warfare/results": "*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "papit": {
    "publish": false,
    "type": "game",
    "main": "game"
  }
}
