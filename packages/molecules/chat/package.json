{
  "name": "@arrow-warfare/chat",
  "description": "Plain text chat with tabs for everyone and the team.",
  "keywords": [
    "papit",
    "typescript",
    "chat"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/arrow-warfare/tree/main/packages/molecules/chat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/arrow-warfare.git",
    "directory": "packages/molecules/chat"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@papit/button": "^0.1.10",
    "@papit/input": "^0.0.10",
    "@arrow-warfare/core": "*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@papit/theme": "*"
  },
  "papit": {
    "publish": false,
    "type": "web-component",
    "main": "chat",
    "htmlprefix": "aw"
  }
}
