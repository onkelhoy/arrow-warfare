{
  "name": "@arrow-warfare/play",
  "description": "The play screen, a placeholder until the meadow exists.",
  "keywords": [
    "papit",
    "typescript",
    "play"
  ],
  "version": "0.0.1",
  "scripts": {
    "build": "npx @papit/build -- --error --ancestors",
    "watch": "tsc -w",
    "start": "npx @papit/server --info --live"
  },
  "main": "./lib/bundle.js",
  "types": "./lib/bundle.d.ts",
  "type": "module",
  "files": [
    "asset/",
    "lib/"
  ],
  "exports": {
    ".": {
      "import": "./lib/bundle.js",
      "types": "./lib/bundle.d.ts"
    }
  },
  "author": "henry",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/onkelhoy/arrow-warfare/tree/main/packages/pages/play",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkelhoy/arrow-warfare.git",
    "directory": "packages/pages/play"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@arrow-warfare/core": "*",
    "@papit/button": "^0.1.10"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "papit": {
    "publish": false,
    "type": "library",
    "main": "play"
  }
}
